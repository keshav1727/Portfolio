# Environment Variables - Portfolio Backend
# Copy this to .env and fill in real values

# Server
PORT=3000
ALLOWED_ORIGIN=*

# Telegram Bot (contact form delivery)
# 1. Message @BotFather on Telegram, send /newbot, and copy the token it gives you.
# 2. Message your new bot once, then visit:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    to find your chat id in the response.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
